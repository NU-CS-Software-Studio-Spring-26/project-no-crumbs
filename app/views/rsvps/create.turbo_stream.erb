<%= turbo_stream.replace "rsvp-buttons-#{@post.id}" do %>
  <%= render "rsvps/buttons", post: @post, rsvp: @rsvp %>
<% end %>

<%= turbo_stream.replace "rsvp-guest-list-#{@post.id}" do %>
  <%= render "rsvps/guest_list", post: @post %>
<% end %>

<%= turbo_stream.replace "rsvp-count-#{@post.id}" do %>
  <%= render "rsvps/count", post: @post %>
<% end %>
