<% content_for :title, @user.username %>
<% unless params[:direct] %>
  <% back_path = safe_users_return_path(params[:return_to]) %>
  <div class="mb-3">
    <%= link_to back_path, class: "btn-outline-nc btn-sm-nc" do %>
      <i class="bi bi-arrow-left"></i> Back
    <% end %>
  </div>
<% end %>

<div class="profile-card">
  <div class="profile-cover gc-meal"></div>

  <div class="profile-card-body">
    <div class="profile-avatar-row">
      <%= avatar_tag @user, size: :xl %>
      <div class="profile-actions">
        <% if current_user == @user %>
          <%= link_to edit_user_path(@user), class: "btn-outline-nc btn-sm-nc" do %>
            <i class="bi bi-pencil"></i> Edit
          <% end %>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "btn-outline-nc btn-sm-nc" do %>
            <i class="bi bi-box-arrow-right"></i> Sign Out
          <% end %>
        <% elsif admin? %>
          <%= link_to edit_user_path(@user), class: "btn-outline-nc btn-sm-nc" do %>
            <i class="bi bi-pencil"></i> Edit
          <% end %>
          <%= button_to @user, method: :delete,
                form: { data: { turbo_confirm: "Delete #{@user.username}?" } },
                class: "btn-danger-nc btn-sm-nc" do %>
            <i class="bi bi-trash"></i> Delete
          <% end %>
        <% elsif @friendship.nil? || @friendship.status == 'declined' %>
          <%= button_to friendships_path, method: :post, params: { receiver_id: @user.id }, class: "btn-brand-nc btn-sm-nc" do %>
            <i class="bi bi-person-plus"></i> Add Friend
          <% end %>
        <% elsif @friendship.status == 'pending' && @friendship.requester == current_user %>
          <%= button_to friendship_path(@friendship), method: :delete, class: "btn-outline-nc btn-sm-nc" do %>
            <i class="bi bi-hourglass"></i> Request Sent
          <% end %>
        <% elsif @friendship.status == 'pending' && @friendship.receiver == current_user %>
          <%= button_to friendship_path(@friendship), method: :patch, params: { status: 'accepted' }, class: "btn-brand-nc btn-sm-nc" do %>
            <i class="bi bi-check"></i> Accept
          <% end %>
          <%= button_to friendship_path(@friendship), method: :patch, params: { status: 'declined' }, class: "btn-outline-nc btn-sm-nc" do %>
            Decline
          <% end %>
        <% elsif @friendship.status == 'accepted' %>
          <%= button_to friendship_path(@friendship), method: :delete,
                form: { data: { turbo_confirm: "Unfriend #{@user.username}?" } },
                class: "btn-outline-nc btn-sm-nc" do %>
            <i class="bi bi-person-check"></i> Friends
          <% end %>
        <% end %>
      </div>
    </div>

    <h1 class="profile-username"><%= @user.username %></h1>
    <p class="profile-email">
      <i class="bi bi-envelope" style="font-size:0.75rem"></i>
      <%= @user.email %>
    </p>
    <% if @user.bio.present? %>
      <p class="profile-bio"><%= @user.bio %></p>
    <% end %>
    <% if @user.dietary_restrictions.present? %>
      <div class="profile-dietary">
        <% @user.dietary_restrictions.each do |r| %>
          <span class="tag tag-dietary"><%= dietary_restriction_label(r) %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="profile-stats-bar">
    <div class="profile-stat">
      <span class="profile-stat-num"><%= @user.posts.count %></span>
      <span class="profile-stat-label"><%= @user.posts.count == 1 ? "Meal Hosted" : "Meals Hosted" %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat-num"><%= @user.friends.count %></span>
      <span class="profile-stat-label"><%= @user.friends.count == 1 ? "Friend" : "Friends" %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat-num"><%= @rsvps_sent %></span>
      <span class="profile-stat-label"><%= @rsvps_sent == 1 ? "Meal Attending" : "Meals Attending" %></span>
    </div>
    <div class="profile-stat">
      <span class="profile-stat-num"><%= @rsvps_received %></span>
      <span class="profile-stat-label">RSVPs Received</span>
    </div>
  </div>
</div>

<% if @active_posts.nil? %>
  <div class="locked-meals">
    <i class="bi bi-lock"></i>
    <p>Add <%= @user.username %> as a friend to see their meals.</p>
  </div>
<% else %>
  <% if @active_posts.any? %>
    <p class="section-label">Meals hosted</p>
    <div class="nc-table-wrap">
      <table class="nc-table">
        <colgroup>
          <col style="width:40%">
          <col style="width:20%">
          <col style="width:28%">
          <col style="width:12%">
        </colgroup>
        <thead>
          <tr>
            <th>Meal</th>
            <th>Date</th>
            <th>Time</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @active_posts.each do |post| %>
            <tr>
              <td><%= post.title %></td>
              <td><%= post.meal_date&.strftime("%b %-d, %Y") || "—" %></td>
              <td><%= meal_time_range(post) || "—" %></td>
              <td class="text-end">
                <%= link_to "View", post, class: "btn-outline-nc btn-sm-nc" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @archived_posts.any? %>
    <p class="section-label">Archived meals</p>
    <div class="nc-table-wrap">
      <table class="nc-table nc-table-muted">
        <colgroup>
          <col style="width:40%">
          <col style="width:20%">
          <col style="width:28%">
          <col style="width:12%">
        </colgroup>
        <thead>
          <tr>
            <th>Meal</th>
            <th>Date</th>
            <th>Time</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @archived_posts.each do |post| %>
            <tr>
              <td><%= post.title %></td>
              <td><%= post.meal_date&.strftime("%b %-d, %Y") || "—" %></td>
              <td><%= meal_time_range(post) || "—" %></td>
              <td class="text-end">
                <%= link_to "View", post, class: "btn-outline-nc btn-sm-nc" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>

<% if @upcoming_rsvps&.any? %>
  <div class="d-flex align-items-center justify-content-between mb-1">
    <p class="section-label mb-0">Meals I'm attending</p>
    <%= link_to export_rsvps_path, class: "btn-outline-nc btn-sm-nc" do %>
      <i class="bi bi-calendar-check"></i> Export to Calendar
    <% end %>
  </div>
  <div class="nc-table-wrap">
    <table class="nc-table">
      <colgroup>
        <col style="width:40%">
        <col style="width:20%">
        <col style="width:28%">
        <col style="width:12%">
      </colgroup>
      <thead>
        <tr>
          <th>Meal</th>
          <th>Date</th>
          <th>Time</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @upcoming_rsvps.each do |rsvp| %>
          <tr>
            <td>
              <%= rsvp.post.title %>
              <% if rsvp.status == "going" %>
                <span class="tag" style="margin-left:6px;background:var(--going-bg,#d1fae5);color:var(--going-fg,#065f46)">Going</span>
              <% else %>
                <span class="tag" style="margin-left:6px;background:var(--maybe-bg,#fef9c3);color:var(--maybe-fg,#713f12)">Maybe</span>
              <% end %>
            </td>
            <td><%= rsvp.post.meal_date.strftime("%b %-d, %Y") %></td>
            <td><%= meal_time_range(rsvp.post) %></td>
            <td class="text-end">
              <%= link_to "View", rsvp.post, class: "btn-outline-nc btn-sm-nc" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<% if @user.friends.any? %>
  <p class="section-label">Friends</p>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    <% @user.friends.each do |friend| %>
      <div class="col"><%= render friend %></div>
    <% end %>
  </div>
<% end %>
