<%= form_with(model: user, data: { controller: "unsaved-changes", action: "submit->unsaved-changes#submit" }) do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger mb-4">
      <strong><%= pluralize(user.errors.count, "error") %>:</strong>
      <ul class="mb-0 mt-1 ps-3">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4 d-flex align-items-center gap-3">
    <div id="avatar-preview" class="flex-shrink-0">
      <% if user.avatar.attached? && user.avatar.blob.persisted? %>
        <%= image_tag user.avatar, class: "avatar avatar-xl", alt: user.username %>
      <% else %>
        <div class="avatar avatar-xl"><%= user.username[0].upcase %></div>
      <% end %>
    </div>
    <div class="flex-grow-1">
      <%= form.label :avatar, "Profile Photo", class: "form-label" %>
      <%= form.file_field :avatar, class: "form-control", accept: "image/*", id: "avatar-file-input" %>
      <small class="text-muted">JPEG, PNG, WebP or GIF · max 5MB</small>
    </div>
  </div>

  <div class="mb-3" data-controller="char-counter" data-char-counter-max-value="30">
    <%= form.label :username, class: "form-label" %>
    <%= form.text_field :username, class: "form-control", placeholder: "e.g. spaghetti_sam",
          required: true, minlength: 2, maxlength: 30,
          pattern: "[a-zA-Z0-9_]+", title: "Letters, numbers, and underscores only",
          data: { "char-counter-target": "input", action: "input->char-counter#update" } %>
    <span data-char-counter-target="counter" class="char-counter"></span>
  </div>

  <div class="mb-3">
    <%= form.label :email, class: "form-label" %>
    <%= form.email_field :email, class: "form-control", placeholder: "you@school.edu", required: true %>
  </div>

  <div class="mb-4" data-controller="char-counter" data-char-counter-max-value="500">
    <%= form.label :bio, class: "form-label" %>
    <%= form.textarea :bio, class: "form-control", rows: 3,
          placeholder: "A little about yourself...",
          maxlength: 500,
          data: { "char-counter-target": "input", action: "input->char-counter#update" } %>
    <span data-char-counter-target="counter" class="char-counter"></span>
  </div>

  <div class="mb-4">
    <label class="form-label">Dietary Restrictions</label>
    <p class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">Select any that apply to you. Meals that don't accommodate these will show a warning.</p>
    <input type="hidden" name="user[dietary_restrictions][]" value="">
    <div class="d-flex flex-wrap gap-2" data-controller="dietary-picker">
      <% DietaryRestrictionsHelper::DIETARY_RESTRICTION_OPTIONS.each do |value, label| %>
        <% selected = (user.dietary_restrictions || []).include?(value) %>
        <label class="dietary-check <%= 'dietary-check--selected' if selected %>">
          <%= check_box_tag "user[dietary_restrictions][]", value, selected,
              id: "user_dr_#{value}", class: "dietary-check-input",
              data: { action: "change->dietary-picker#toggle" } %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </div>

  <%= form.submit class: "btn-nc" %>
<% end %>

<script>
  (function() {
    var input = document.getElementById("avatar-file-input");
    if (!input) return;
    input.addEventListener("change", function() {
      var file = this.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById("avatar-preview").innerHTML =
          '<img src="' + e.target.result + '" class="avatar avatar-xl" alt="Preview">';
      };
      reader.readAsDataURL(file);
    });
  })();
</script>
