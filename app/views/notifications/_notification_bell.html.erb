<% unread = current_user.notifications.unread.count %>
<%= link_to notifications_path, class: "nc-nav-icon nc-notif-bell", aria: { label: "Notifications (#{unread} unread)" } do %>
  <i class="bi bi-bell<%= "-fill" if unread > 0 %>" aria-hidden="true"></i>
  <% if unread > 0 %>
    <span class="nc-notif-badge" aria-hidden="true"><%= unread > 99 ? "99+" : unread %></span>
  <% end %>
<% end %>
