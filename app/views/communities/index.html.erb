<% content_for :title, "Communities" %>

<div class="feed-header">
  <div>
    <h1 class="feed-title">Communities</h1>
    <p class="feed-subtitle">Find your group, eat together</p>
  </div>
  <%= link_to new_community_path, class: "nc-nav-cta" do %>
    <i class="bi bi-plus"></i> New Community
  <% end %>
</div>

<div data-controller="user-search">
  <%= form_with url: communities_path, method: :get, class: "nc-search-form",
      data: { user_search_target: "form", turbo_frame: "community-results" } do %>
    <div class="nc-search-wrap">
      <i class="bi bi-search nc-search-icon"></i>
      <%= text_field_tag :q, @query,
          placeholder: "Search communities…",
          class: "nc-search-input",
          autocomplete: "off",
          data: { user_search_target: "input", action: "input->user-search#search" } %>
      <a href="#" class="nc-search-clear<%= " d-none" unless @query.present? %>"
         aria-label="Clear search"
         data-user-search-target="clear"
         data-action="click->user-search#clear">
        <i class="bi bi-x"></i>
      </a>
    </div>
  <% end %>

  <turbo-frame id="community-results">
    <% if @communities.empty? %>
      <div class="empty-state">
        <div class="empty-icon">🏘️</div>
        <% if @query.present? %>
          <p class="empty-title">No results for "<%= @query %>"</p>
          <p class="empty-sub">Try a different name.</p>
        <% else %>
          <p class="empty-title">No communities yet</p>
          <p class="empty-sub">Be the first to create one and bring your group together.</p>
          <%= link_to new_community_path, class: "btn-brand-nc" do %>
            <i class="bi bi-plus"></i> Create Community
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="nc-table-wrap">
        <table class="nc-table">
          <thead>
            <tr>
              <th>Community</th>
              <th>Members</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @communities.each do |community| %>
              <tr>
                <td>
                  <%= link_to community.name, community, class: "user-table-link", data: { turbo_frame: "_top" } %>
                  <% if community.description.present? %>
                    <div style="font-size:0.8rem;color:var(--muted);font-weight:400;margin-top:2px">
                      <%= truncate(community.description, length: 72) %>
                    </div>
                  <% end %>
                </td>
                <td><%= community.members.count %></td>
                <td class="text-end">
                  <% if community.member?(current_user) %>
                    <span class="tag tag-brand"><i class="bi bi-check2"></i> Joined</span>
                  <% else %>
                    <%= button_to community_membership_path(community), method: :post,
                          class: "btn-brand-nc btn-sm-nc", data: { turbo_frame: "_top" } do %>
                      <i class="bi bi-person-plus"></i> Join
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @pagy && @pagy.pages > 1 %>
        <nav class="d-flex justify-content-center mt-4" aria-label="Communities pagination">
          <%= raw(@pagy.series_nav(:bootstrap)) %>
        </nav>
      <% end %>
    <% end %>
  </turbo-frame>
</div>
