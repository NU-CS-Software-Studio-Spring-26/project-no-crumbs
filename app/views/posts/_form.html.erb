<%= form_with(model: post, data: { controller: "ai-description unsaved-changes", action: "submit->unsaved-changes#submit" }) do |form| %>
  <% if post.errors.any? %>
    <div class="alert alert-danger mb-4">
      <strong><%= pluralize(post.errors.count, "error") %>:</strong>
      <ul class="mb-0 mt-1 ps-3">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3" data-controller="char-counter" data-char-counter-max-value="100">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "e.g. Backyard pasta night",
          required: true, maxlength: 100,
          data: { "char-counter-target": "input", action: "input->char-counter#update", "ai-description-target": "title" } %>
    <span data-char-counter-target="counter" class="char-counter"></span>
  </div>

  <div class="mb-3" data-controller="char-counter" data-char-counter-max-value="2000">
    <div class="d-flex align-items-center gap-2 mb-1">
      <%= form.label :description, class: "form-label mb-0" %>
      <button type="button" class="btn-ai-suggest"
              data-ai-description-target="button"
              data-action="click->ai-description#generate">✨ AI suggest</button>
    </div>
    <%= form.textarea :description, class: "form-control", rows: 4,
          placeholder: "What's on the menu? Any details to share?",
          maxlength: 2000,
          data: { "char-counter-target": "input",
                  action: "input->char-counter#update input->ai-description#clearBadge",
                  "ai-description-target": "description" } %>
    <div class="d-flex align-items-center">
      <span class="ai-generated-note d-none" data-ai-description-target="badge">✨ ai generated</span>
      <span data-char-counter-target="counter" class="char-counter ms-auto"></span>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label">Dietary Accommodations</label>
    <p class="text-muted" style="font-size:0.85rem;margin-bottom:0.5rem">Check everything this meal can accommodate. Guests with unmet restrictions will see a warning.</p>
    <input type="hidden" name="post[dietary_restrictions][]" value="">
    <div class="d-flex flex-wrap gap-2" data-controller="dietary-picker">
      <% DietaryRestrictionsHelper::DIETARY_RESTRICTION_OPTIONS.each do |value, label| %>
        <% selected = (post.dietary_restrictions || []).include?(value) %>
        <label class="dietary-check <%= 'dietary-check--selected' if selected %>">
          <%= check_box_tag "post[dietary_restrictions][]", value, selected,
              id: "post_dr_#{value}", class: "dietary-check-input",
              data: { action: "change->dietary-picker#toggle" } %>
          <%= label %>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mb-3" data-controller="datepicker"
       data-datepicker-initial-value="<%= post.meal_date&.strftime('%Y-%m-%dT%H:%M') %>">
    <%= form.label :meal_date, "Date & Time", class: "form-label" %>
    <input type="text" data-datepicker-target="display" class="form-control"
           placeholder="e.g. May 10, 2026 at 7:00 PM" readonly style="cursor:pointer" autocomplete="off">
    <%= form.hidden_field :meal_date, data: { datepicker_target: "hidden" } %>
  </div>

  <div class="mb-3">
    <%= form.label :duration_minutes, "Duration", class: "form-label" %>
    <%= form.select :duration_minutes,
          [["30 min", 30], ["1 hr", 60], ["1.5 hrs", 90], ["2 hrs", 120],
           ["2.5 hrs", 150], ["3 hrs", 180], ["3.5 hrs", 210], ["4 hrs", 240]],
          { selected: post.duration_minutes || 60 },
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :address, "Location", class: "form-label" %>
    <%= form.text_field :address, class: "form-control", placeholder: "e.g. 123 Main St, Evanston, IL" %>
  </div>

  <% if @user_communities.any? %>
    <div class="mb-4">
      <%= form.label :community_ids, "Post to communities", class: "form-label" %>
      <div class="d-flex flex-wrap gap-2 mt-1">
        <%= form.collection_check_boxes :community_ids, @user_communities, :id, :name do |b| %>
          <label class="community-check-pill">
            <%= b.check_box class: "community-check-input" %>
            <%= b.text %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= form.submit class: "btn-nc" %>

  <div data-ai-description-target="overlay"
       style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:12px; padding:2rem; max-width:480px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,0.2);">
      <h5 style="margin-bottom:0.5rem; font-weight:600;">Describe your meal</h5>
      <p style="color:#888; margin-bottom:1rem; font-size:0.875rem;">(Optional) Include a 1 sentence description to give the AI a better idea of your meal.</p>
      <textarea data-ai-description-target="mealInput"
                data-action="keydown->ai-description#handleKeydown"
                class="form-control"
                rows="2"
                placeholder="e.g. A cozy pasta dinner with fresh homemade sauce and garlic bread"
                style="margin-bottom:1rem;"></textarea>
      <div class="d-flex gap-2 justify-content-end">
        <button type="button" class="btn-ai-suggest" style="background:#111827;" data-action="click->ai-description#cancelOverlay">Cancel</button>
        <button type="button" class="btn-ai-suggest" data-action="click->ai-description#confirmOverlay">Generate ✨</button>
      </div>
    </div>
  </div>
<% end %>
