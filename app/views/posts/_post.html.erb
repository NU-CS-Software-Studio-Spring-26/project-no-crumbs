<div class="meal-card" id="<%= dom_id post %>">
  <div class="meal-cover <%= post.cover_photo_url? ? "meal-cover-photo" : "gc-meal" %>"
       <%= post.cover_photo_url? ? "style=background-image:url('#{post.cover_photo_url}')" : "" %>>
    <div class="meal-cover-date">
      <span class="day"><%= post.meal_date&.strftime("%-d") || "?" %></span>
      <span class="mon"><%= post.meal_date&.strftime("%b") || "—" %></span>
    </div>
    <% meal_date_local = post.meal_date&.in_time_zone&.to_date %>
    <% if meal_date_local == Time.zone.today %>
      <span class="meal-urgency-badge meal-urgency-badge--cover">Today</span>
    <% elsif meal_date_local == Time.zone.tomorrow %>
      <span class="meal-urgency-badge meal-urgency-badge--cover meal-urgency-badge--tomorrow">Tomorrow</span>
    <% end %>
  </div>

  <div class="meal-card-body">
    <div class="d-flex align-items-start justify-content-between gap-2">
      <h3 class="meal-card-title" style="margin:0"><%= post.title %></h3>
      <%= render "likes/like_button", likeable: post, size: :small %>
    </div>
    <div class="meal-card-when">
      <i class="bi bi-clock" style="font-size:0.75rem;color:var(--muted)"></i>
      <span><%= post.meal_date ? "#{post.meal_date.strftime("%a, %b %-d")} · #{meal_time_range(post)}" : "Date TBD" %></span>
    </div>
    <% if post.address.present? %>
      <div class="meal-card-when">
        <i class="bi bi-geo-alt" style="font-size:0.75rem;color:var(--muted)"></i>
        <span><%= post.address %></span>
      </div>
    <% end %>
    <% if post.description.present? %>
      <p class="meal-card-desc"><%= post.description %></p>
    <% end %>
    <div class="d-flex align-items-center gap-3">
      <%= render "rsvps/count", post: post %>
      <% comment_count = post.comments.count %>
      <% if comment_count > 0 %>
        <span class="meal-meta-count">
          <i class="bi bi-chat" style="font-size:0.7rem"></i>
          <%= comment_count %>
        </span>
      <% end %>
    </div>
  </div>

  <% if (unmet = unmet_dietary_restrictions(post)).any? %>
    <div class="dietary-warning-banner">
      <i class="bi bi-exclamation-triangle-fill"></i>
      May not accommodate: <%= unmet.map { |r| dietary_restriction_label(r) }.join(", ") %>
    </div>
  <% end %>

  <div class="meal-card-footer">
    <%= link_to post.user, class: "meal-host-link" do %>
      <%= avatar_tag post.user, size: :sm %>
      <span class="meal-host-name"><%= post.user.username %></span>
    <% end %>
    <div class="d-flex gap-1 align-items-center">
      <%= link_to "View", post, class: "btn-outline-nc btn-sm-nc" %>
      <% if admin? && current_user != post.user %>
        <%= link_to edit_post_path(post), class: "btn-outline-nc btn-sm-nc" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
        <%= button_to post, method: :delete,
              form: { data: { turbo_confirm: "Delete \"#{post.title}\"?" } },
              class: "btn-danger-nc btn-sm-nc" do %>
          <i class="bi bi-trash"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
