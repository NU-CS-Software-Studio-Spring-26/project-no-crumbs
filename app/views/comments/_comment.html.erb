<div class="comment" id="<%= dom_id comment %>">
  <div class="comment-avatar">
    <div class="avatar avatar-sm"><%= comment.user.username[0].upcase %></div>
  </div>
  <div class="comment-body">
    <div class="comment-header">
      <%= link_to comment.user, class: "comment-username" do %>
        <%= comment.user.username %>
      <% end %>
      <span class="comment-time"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>
    <p class="comment-text"><%= comment.body %></p>
  </div>
  <div class="comment-actions">
    <%= render "likes/like_button", likeable: comment, size: :small %>
    <% if comment.user == current_user %>
      <%= button_to post_comment_path(comment.post, comment),
            method: :delete,
            class: "comment-delete-btn",
            form: { data: { turbo_stream: true } } do %>
        <i class="bi bi-x"></i>
      <% end %>
    <% end %>
  </div>
</div>
