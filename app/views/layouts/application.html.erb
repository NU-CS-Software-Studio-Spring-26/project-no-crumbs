<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "No Crumbs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="nc-nav">
      <div class="nc-nav-left">
        <%= link_to root_path, class: "nc-brand" do %>
          No<span>Crumbs</span>
        <% end %>
      </div>
      <div class="nc-nav-mid">
        <% if user_signed_in? %>
          <%= link_to "Meals", posts_path, class: "nc-nav-link #{'nc-nav-link-active' if request.path.start_with?(posts_path)}" %>
          <%= link_to "Friends", friendships_path, class: "nc-nav-link #{'nc-nav-link-active' if request.path.start_with?(friendships_path)}" %>
          <%= link_to "Communities", communities_path, class: "nc-nav-link #{'nc-nav-link-active' if request.path.start_with?(communities_path)}" %>
        <% end %>
      </div>
      <div class="nc-nav-right">
        <% if user_signed_in? %>
          <%= link_to user_path(current_user, direct: 1), class: "nc-nav-icon nc-nav-desktop-only", aria: { label: "My Profile" } do %>
            <i class="bi bi-person-circle"></i>
          <% end %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "nc-nav-link nc-nav-desktop-only" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "nc-nav-cta nc-nav-desktop-only" %>
        <% end %>
        <button class="nc-hamburger nc-nav-mobile-only" id="nc-hamburger" aria-label="Menu">
          <i class="bi bi-list"></i>
        </button>
      </div>
    </nav>

    <div class="nc-mobile-menu" id="nc-mobile-menu">
      <% if user_signed_in? %>
        <%= link_to "Meals", posts_path, class: "nc-mobile-link #{'nc-mobile-link-active' if request.path.start_with?(posts_path)}" %>
        <%= link_to "Friends", friendships_path, class: "nc-mobile-link #{'nc-mobile-link-active' if request.path.start_with?(friendships_path)}" %>
        <%= link_to "Communities", communities_path, class: "nc-mobile-link #{'nc-mobile-link-active' if request.path.start_with?(communities_path)}" %>
        <%= link_to user_path(current_user, direct: 1), class: "nc-mobile-link" do %>
          <i class="bi bi-person-circle"></i> Profile
        <% end %>
      <% else %>
        <%= link_to "Sign In", new_user_session_path, class: "nc-mobile-link" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "nc-mobile-link nc-mobile-link-cta" %>
      <% end %>
    </div>

    <div class="nc-container">
      <% if notice.present? %>
        <div class="nc-flash">
          <i class="bi bi-check-circle-fill"></i>
          <%= notice %>
        </div>
      <% end %>
      <% if alert.present? && !devise_controller? %>
        <div class="nc-flash nc-flash-alert">
          <i class="bi bi-exclamation-circle-fill"></i>
          <%= alert %>
        </div>
      <% end %>
      <%= yield %>
    </div>

    <footer class="nc-footer">
      <div class="nc-footer-inner">
        <%= link_to root_path, class: "nc-footer-brand" do %>
          No<span>Crumbs</span>
        <% end %>
        <nav class="nc-footer-links">
          <%= link_to "About", about_path, class: "nc-footer-link" %>
          <%= link_to "Legal & Privacy", legal_path, class: "nc-footer-link" %>
          <a href="https://github.com/NU-CS-Software-Studio-Spring-26/project-no-crumbs" class="nc-footer-link" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-github"></i> GitHub
          </a>
        </nav>
        <p class="nc-footer-copy">&copy; <%= Date.current.year %> NoCrumbs &mdash; Northwestern CS 397</p>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener("turbo:load", function() {
        const hamburger = document.getElementById("nc-hamburger");
        const menu = document.getElementById("nc-mobile-menu");
        if (hamburger && menu) {
          if (!hamburger.dataset.listenerAttached) {
            hamburger.dataset.listenerAttached = "true";
            hamburger.addEventListener("click", function(e) {
              e.stopPropagation();
              menu.classList.toggle("open");
            });
            document.addEventListener("click", function() {
              menu.classList.remove("open");
            });
          }
        }

        document.querySelectorAll(".nc-flash").forEach(function(flash) {
          setTimeout(function() {
            flash.classList.add("nc-flash-hide");
            setTimeout(function() { flash.remove(); }, 400);
          }, 3500);
        });
      });
    </script>
  </body>
</html>
